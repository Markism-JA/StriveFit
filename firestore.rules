rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: private user-specific data
    match /Users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Exercises: shared across all authenticated users
    match /Exercise/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // Badges: public for all users (read-only), admin for write
    match /Badges/{badgeId} {
        allow read; // <-- CHANGED: Now public, no authentication required
        allow write: if request.auth.token.admin == true;
    }

    // Challenges: public for all authenticated users (read-only)
    match /Challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
  }
}
